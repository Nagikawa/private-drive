{
	"name": "@private-drive/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
		"start": "node --env-file=../../.env --import tsx src/main.ts",
		"build": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"lint": "pnpm exec oxlint .",
		"lint:fix": "pnpm exec oxlint --fix ."
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.940.0",
		"@effect/platform-node": "^4.1.1",
		"@private-drive/domain": "workspace:*",
		"effect": "^4.1.1"
	},
	"devDependencies": {
		"@effect/vitest": "^4.1.2",
		"@types/node": "^24.10.0",
		"tsx": "^4.20.6",
		"typescript": "~6.0.2",
		"vitest": "^4.1.12"
	}
}
