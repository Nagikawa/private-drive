{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"lint:fix": {
			"cache": false
		},
		"//#format": {},
		"//#format:fix": {
			"cache": false
		}
	}
}
