{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "private-drive",
	"main": "apps/api/src/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"assets": {
		"directory": "apps/web/dist/web/browser",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/health", "/metrics"]
	},
	"vars": {
		"COOKIE_SECURE": "true",
		"DATA_DIR": "state"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DRIVE_STATE",
				"class_name": "DriveState"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DriveState"]
		}
	]
}
